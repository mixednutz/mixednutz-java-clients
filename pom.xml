<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<groupId>net.mixednutz</groupId>
	<artifactId>mixednutz-java-clients</artifactId>
	<version>2.2.0.1</version>
	<packaging>pom</packaging>

	<name>MixedNutz Java API Clients</name>
	<url>https://www.mixednutz.net</url>
	<description>MixedNutz API for Java.  Default client implementations and network adapters.</description>

	<!--
		Using Spring Boot Starter to keep dependencies syncronized across projects
	 -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>2.6.14</version>
		<relativePath /> <!-- lookup parent from repository -->
	</parent>

	<modules>
		<module>mixednutz-java-api-core</module>
		<module>mixednutz-java-api-discord</module>
		<module>mixednutz-java-api-bluesky</module>
		<module>mixednutz-java-api-patreon</module>
	</modules>

	<organization>
		<name>Andrew Festa</name>
		<url>http://www.andrewfesta.com</url>
	</organization>

	<scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
		<connection>scm:git:ssh://git@github.com/mixednutz/mixednutz-java-clients.git</connection>
		<developerConnection>scm:git:ssh://git@github.com/mixednutz/mixednutz-java-clients.git</developerConnection>
		<url>https://github.com/mixednutz/mixednutz-java-clients</url>
		<tag>mixednutz-java-clients-2.2.0.1</tag>
	</scm>

	<!--
		Deploy JARs to GitHub.  Fixed URL (not ${project.artifactId}) so every
		module, and this parent pom, publish to this repo's package registry.
	 -->
	<distributionManagement>
		<repository>
			<id>github</id>
			<name>GitHub MixedNutz Apache Maven Packages</name>
			<url>https://maven.pkg.github.com/mixednutz/mixednutz-java-clients</url>
		</repository>
	</distributionManagement>

	<repositories>
		<repository>
			<id>github</id>
			<name>GitHub Mixednutz Apache Maven Packages</name>
			<url>https://maven.pkg.github.com/mixednutz/mixednutz-java-api</url>
			<releases><enabled>true</enabled></releases>
			<snapshots><enabled>true</enabled></snapshots>
		</repository>
	</repositories>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<java.version>11</java.version>

		<mixednutz-api.version>2.1.6.1</mixednutz-api.version>
		<spring-social.version>1.1.6.RELEASE</spring-social.version>
	</properties>

	<build>
		<plugins>
			<!-- Maven Release Plugin: one version and one tag for all modules -->
			<plugin>
				<artifactId>maven-release-plugin</artifactId>
				<version>2.4.2</version>
				<configuration>
					<autoVersionSubmodules>true</autoVersionSubmodules>
				</configuration>
				<dependencies>
					<dependency>
						<groupId>org.apache.maven.scm</groupId>
						<artifactId>maven-scm-provider-gitexe</artifactId>
						<version>1.8.1</version>
					</dependency>
				</dependencies>
			</plugin>
		</plugins>
	</build>

</project>
